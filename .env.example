# Copy to `.env` for local development:   cp .env.example .env
#
# Every VITE_* value is inlined into the JS bundle by Vite at BUILD time, so
# none of them is a secret, and deployments do NOT read this file: the Build
# step in .github/workflows/azure-static-web-apps-*.yml takes VITE_API_BASE from
# the GitHub repo's Settings -> Secrets and variables -> Actions -> Variables.
#
# Setting them in the Azure portal's Static Web App "Environment variables"
# blade does NOT work: that blade only configures the managed Functions
# runtime, and by the time the app runs in a browser the values are already
# baked into the bundle.
#
# After changing this file, restart `npm run dev` and hard-reload the browser
# (Ctrl+Shift+R): the values are inlined into the bundle.

# ---------------------------------------------------------------- API
#
# KEEP THIS EMPTY IN DEVELOPMENT. Empty means "same origin": the browser calls
# http://localhost:3000/api/v1/... and the Vite dev server proxies that to
# VITE_BACKEND_ORIGIN below.
#
# Any non-empty value bypasses the proxy completely and the browser talks to
# that server directly. People have lost hours to this: with it set to the
# production origin, `npm run dev` silently uses PRODUCTION data, and an
# endpoint that only exists on your local backend answers 404.
#
# Production builds (CI) set it to the API's absolute origin — origin only, no
# trailing slash and no /api/v1 (src/lib/env.ts appends that itself).
# vite.config.ts fails the build if it is empty or malformed.
VITE_API_BASE=

# Which backend the dev server proxies /api, /uploads and /files to.
# Only read by vite.config.ts, only by `npm run dev`.
#
# Your own backend from the H7_LMS- repo (`uvicorn ... --port 8000`):
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
#
# Or, to work on UI only without running the backend, proxy to the deployed
# one. CAREFUL: that is the live school's data. Anything you create, edit or
# delete happens for real.
# VITE_BACKEND_ORIGIN=https://h7-lms-bknd-hhaqd9cdcfe7f9gh.indiasouthcentral-01.azurewebsites.net


# ------------------------------------------------------------- Sign-in
#
# Nothing to configure here. Sign-in, live classes (Azure Communication
# Services), file storage and email are all provided by the backend; the app
# only needs the two values above. (Old VITE_FIREBASE_* / VITE_GOOGLE_* keys
# are no longer read by anything and can be deleted from your .env.)
