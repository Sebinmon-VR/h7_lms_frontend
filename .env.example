# ---------------------------------------------------------------- API
#
# This file documents LOCAL development. Every VITE_* value below is inlined
# into the JS bundle by Vite at BUILD time, so deployments get them from the
# environment that runs `npm run build` — for Azure that is the `env:` block on
# the Build step in .github/workflows/azure-static-web-apps-*.yml, fed from the
# GitHub repo's Settings -> Secrets and variables -> Actions -> Variables.
#
# Setting them in the Azure portal's Static Web App "Environment variables"
# blade does NOT work: that blade only configures the managed Functions
# runtime, and by the time the app runs in a browser the values are already
# baked into the bundle.

# Leave empty in development: Vite proxies /api and /uploads to the backend
# (see vite.config.ts), which keeps requests same-origin.
#
# In production set this to the absolute origin of the FastAPI server — origin
# only, no trailing slash and no /api/v1 (src/lib/env.ts appends that itself):
#   VITE_API_BASE=https://lms-api.example.com
#
# There is no proxy in a production build, so leaving this empty makes every
# request resolve against the static site's own origin and return HTML instead
# of JSON. vite.config.ts fails the build if it is empty.
VITE_API_BASE=

# Origin the dev server proxies to. Only read by vite.config.ts.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000


# ----------------------------------------------------------- Firebase

# The backend verifies Firebase ID tokens, so this is the real sign-in path:
# the browser authenticates against Firebase and sends the ID token as a
# bearer token on every request.
#
# These values are NOT secrets. A Firebase web config is public by design —
# access is governed by Firebase Auth rules and the backend's own RBAC, not by
# keeping the API key hidden.
#
# Copy them from the Firebase Console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup
#
# Leave VITE_FIREBASE_API_KEY empty to fall back to the backend's
# POST /auth/login development helper. That fallback needs FIREBASE_WEB_API_KEY
# set on the SERVER, cannot refresh tokens (sessions end after one hour), and
# offers no Google sign-in or password reset.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Optional — only needed if the app later uses Firebase Storage or Messaging.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Optional. Restricts the Google sign-in account chooser to one Workspace
# domain, matching GOOGLE_WORKSPACE_DOMAIN on the backend. This is a UX hint
# that Google may ignore — the backend still decides who has a profile.
VITE_GOOGLE_WORKSPACE_DOMAIN=

# Before Google sign-in works, add this app's hostname (and `localhost`) under
# Firebase Console -> Authentication -> Settings -> Authorized domains.
