{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.{css,js,mjs,map,svg,png,jpg,jpeg,ico,webp,woff,woff2}",
      "/legal/*",
      "/arena/*"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json",
    ".mjs": "text/javascript"
  }
}
